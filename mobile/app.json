{
  "expo": {
    "name": "DVD Valet",
    "slug": "dvd-valet",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5f162d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tixpy.dvdvalet",
      "buildNumber": "18",
      "infoPlist": {
        "NSCameraUsageDescription": "DVD Valet uses the camera to scan DVD and Blu-ray UPC barcodes so you can add titles to your personal library, for example while cataloging a new movie at home.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5f162d"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tixpy.dvdvalet",
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "pinataro",
    "scheme": "dvdvalet",
    "extra": {
      "eas": {
        "projectId": "8800b34c-1af1-4f86-85d8-8ac9b532d7e3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font"
    ]
  }
}
